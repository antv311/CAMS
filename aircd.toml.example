# Copy to aircd.toml inside AIRCD_CONFIG_DIR, or pass --config <path>.
# Precedence: command-line flags > environment variables > file > defaults.
# Restart the server after editing. No values are expanded as shell expressions.
bind = "127.0.0.1:6667"
http_bind = "127.0.0.1:6680"
tls_bind = "127.0.0.1:6697"

# File-relative DB and TLS paths resolve beside this config file.
db = "aircd.sqlite3"
# tls_cert = "cert.pem"
# tls_key = "key.pem"
# Mutual TLS (mTLS) client certificate verification and optional HTTPS listener:
# tls_client_ca = "client-ca.pem"
# tls_client_auth = "required"          # none, optional, or required (default required if tls_client_ca is set)
# http_tls_bind = "0.0.0.0:6443"        # HTTPS API listener using the TLS/mTLS config
# tls_only = false                      # true disables plaintext IRC and HTTP listeners

# By default a random owner key is generated once beside the database.
# Prefer AIRCD_REGISTER_KEY to storing a credential in this file.
# register_key = "replace-with-your-private-invite-key"
open_registration = false

# Bearer token lifetime (default: unset = non-expiring).
# [auth]
# token_ttl_seconds = 86400

# HTTP token-bucket rate limiting by client IP and authenticated principal.
# Set *_requests_per_sec = 0 to disable one dimension, or enabled = false to disable both.
# [rate_limit]
# enabled = true
# ip_requests_per_sec = 100.0
# ip_burst = 200
# principal_requests_per_sec = 30.0
# principal_burst = 60
# trust_proxy_headers = false
# max_buckets = 10000

# Forward server errors and security audit logs to Windows Application Event Log
# (Windows only) and/or a syslog daemon.
# windows_event_log = false
# windows_event_log_source = "aircd"
# syslog_target = "udp://127.0.0.1:514"   # or "tcp://127.0.0.1:6514" or "unix:///dev/log"
# syslog_format = "rfc5424"               # or "rfc3164"
# syslog_facility = "auto"                # auto = daemon (errors) / auth (security), or local0..local7

# Automated SQLite snapshot backups preserving database integrity and key rings.
# backup_enabled = true
# backup_dir = "backups"                  # defaults to <db_dir>/backups
# backup_interval_secs = 3600             # 0 disables periodic timer
# backup_retention = 10
# backup_on_startup = false               # true forces a snapshot on every startup

# SQLite connection pooling and WAL tuning for high-concurrency wake bursts.
# db_pool_size = 8                        # read-only WAL connections (1..=128)
# db_busy_timeout_ms = 5000               # milliseconds to wait on SQLITE_BUSY
# db_synchronous = "normal"               # off, normal, full, extra
# db_wal_autocheckpoint = 1000            # WAL pages before auto-checkpoint (0 disables)
# db_cache_size_kib = 16384               # per-connection page cache in KiB
# db_journal_size_limit_bytes = 67108864  # WAL file size limit after checkpoint (-1 unlimited)

# Automated online SQLite defragmentation & non-blocking incremental vacuum.
# db_vacuum_enabled = true                # enable periodic freelist check & incremental vacuum
# db_vacuum_interval_secs = 300           # seconds between freelist checks (0 disables timer)
# db_vacuum_min_freelist_pages = 64       # minimum freelist pages to trigger scheduled vacuum
# db_vacuum_min_freelist_ratio = 0.0      # optional freelist fraction 0.0..=1.0 (0 disables ratio gate)
# db_vacuum_batch_pages = 64              # max pages reclaimed per non-blocking vacuum step
# db_vacuum_step_delay_ms = 25            # pause between batches so active writers never starve
# db_vacuum_max_batches_per_run = 32      # max batches per scheduled pass (0 unlimited)

# Execution timeouts are opt-in for assigned work; claimed tasks retain the
# AIRCD_TASK_LEASE_SECONDS default (300 seconds). Positive per-task overrides
# take precedence over priority, then default. Chat does not renew execution.
# [task_timeout]
# default_seconds = 3600
# [task_timeout.priority_seconds]
# urgent = 900
# high = 1800
# normal = 3600
# low = 7200

# Prometheus alerting rules exporter (/metrics/alerts/rules) & webhook alert evaluator.
# [alerts]
# enabled = true                          # enable background alert evaluation worker
# eval_interval_secs = 15                 # seconds between rule evaluations (0 disables timer)
# webhook_url = "http://127.0.0.1:9095/alerts"  # optional direct alert webhook (HTTPS or LAN/localhost HTTP)
# webhook_secret = "change-me"            # optional HMAC-SHA256 secret for X-AirCD-Signature-256
# repeat_interval_secs = 3600             # seconds between repeat notifications while firing (0 disables repeats)
# send_resolved = true                    # send webhook notification when a firing alert resolves
# group_name = "aircd_alerts"             # rule group name exported in /metrics/alerts/rules YAML
# wake_failure_enabled = true
# wake_failure_rate_threshold = 0.25      # 0.0..=1.0 ratio of (failed+timeout)/completed wakes
# wake_failure_window_secs = 300          # rolling evaluation window in seconds
# wake_failure_min_samples = 5            # minimum completed wakes before failure rate triggers
# wake_failure_for_secs = 120             # sustained breach duration before firing
# wake_failure_severity = "critical"      # info, warning, or critical
# queue_backlog_enabled = true
# queue_backlog_threshold = 50            # pending wake sessions + pending webhook deliveries
# queue_backlog_for_secs = 60
# queue_backlog_severity = "warning"
# disk_pressure_enabled = true
# disk_used_ratio_threshold = 0.90        # 0.0..=1.0 volume used fraction (0 disables ratio check)
# disk_min_free_bytes = 1073741824        # 1 GiB minimum free bytes (0 disables byte floor)
# disk_pressure_for_secs = 60
# disk_pressure_severity = "critical"
# disk_path = "."                         # optional filesystem path override (defaults to DB path)

# Graceful zero-downtime worker draining on hub shutdown (SIGINT/SIGTERM/Windows control events).
# [shutdown]
# drain_timeout_secs = 30                 # max seconds to wait for running wake workers (0 skips wait)
# http_drain_timeout_secs = 5             # max seconds for in-flight HTTP requests to finish
# checkpoint_leases_on_drain = true       # extend claimed leases & refresh execution heartbeats on drain
# lease_checkpoint_extension_secs = 300   # seconds to extend claimed task leases during drain checkpoint
